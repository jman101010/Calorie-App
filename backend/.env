# .env - Environment variables for the backend server
# IMPORTANT: Never commit this file to version control

# OpenAI API Key
OPENAI_API_KEY=

# Server Configuration
PORT=3001

# Optional: Database Connection String
# DATABASE_URL=your_database_connection_string

# Optional: JWT Secret for authentication
# JWT_SECRET=your_jwt_secret
# MongoDB Connection URI
# Replace with your actual MongoDB connection string
# Example for local development: mongodb://localhost:27017/calorieTrackerDB
# Example for MongoDB Atlas: mongodb+srv://username:password@cluster0.mongodb.net/calorieTrackerDB
MONGODB_URI=



# JSON Web Token Secret (for authentication)
# Replace with a strong random string in production
JWT_SECRET=